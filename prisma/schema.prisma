generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id          String  @id @default(cuid())
  fullName    String  @default("AdelereKehinde")
  title       String  @default("Fullstack Developer")
  tagline     String  @default("I build scalable web and mobile applications.")
  about       String  @default("")
  profilePhoto String?
  resumeUrl   String?
  github      String  @default("https://github.com/AdelereKehinde")
  linkedin    String  @default("https://linkedin.com/in/AdelereKehinde")
  twitter     String  @default("https://x.com/AdelereKehinde")
  email       String  @default("adelerekehinde01@gmail.com")
  whatsapp    String  @default("")
  location    String  @default("")
  yearsOfExperience Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id            String   @id @default(cuid())
  title         String
  summary       String
  description   String   @default("")
  coverImage    String?
  techStack     String[]
  liveLink      String?
  githubLink    String?
  problemSolved String   @default("")
  results       String   @default("")
  dateCreated   DateTime @default(now())
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  viewCount     Int      @default(0)
  images        ProjectImage[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProjectImage {
  id        String  @id @default(cuid())
  url       String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
}

model BlogPost {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  content       String
  excerpt       String     @default("")
  coverImage    String?
  author        String     @default("AdelereKehinde")
  published     Boolean    @default(false)
  publishedAt   DateTime   @default(now())
  likeCount     Int        @default(0)
  commentCount  Int        @default(0)
  viewCount     Int        @default(0)
  comments      Comment[]
  likes         BlogLike[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model BlogLike {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  sessionId String
  createdAt DateTime @default(now())

  @@unique([postId, sessionId])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  post      BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  author    String
  email     String
  content   String
  isAdmin   Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  clientName String
  company   String   @default("")
  review    String
  rating    Int      @default(5)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id       String @id @default(cuid())
  name     String
  category String
  level    Int    @default(0)
  icon     String @default("")
  sortOrder Int   @default(0)
}

model WorkExperience {
  id          String   @id @default(cuid())
  company     String
  role        String
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  description String   @default("")
  techStack   String[]
  companyUrl  String?
  location    String   @default("")
  narratives  String   @default("")
  responsibilities String[]
  achievements     String[]
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Service {
  id          String @id @default(cuid())
  title       String
  description String
  icon        String @default("")
  techTags    String[]
  sortOrder   Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Stat {
  id    String @id @default(cuid())
  label String
  value Int
  icon  String @default("")
  sortOrder Int @default(0)
}
